#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_scalar_block_layout : require

// Native GGML Q8_0 matvec: 32 values / 34 bytes per block.
// Bindings: 0 = packed Q8_0 rows, 1 = F32 input, 2 = F32 row outputs.
layout(push_constant) uniform PC { uint rows; uint blocks_per_row; } pc;
layout(scalar, set = 0, binding = 0) readonly buffer Packed { uint8_t raw[]; } packed;
layout(scalar, set = 0, binding = 1) readonly buffer Input { float values[]; } input_data;
layout(scalar, set = 0, binding = 2) writeonly buffer Output { float values[]; } output_data;
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.rows) return;
    float sum = 0.0;
    uint row_base = row * pc.blocks_per_row * 34u;
    for (uint block = 0u; block < pc.blocks_per_row; ++block) {
        uint base = row_base + block * 34u;
        uint d_bits = uint(packed.raw[base]) | (uint(packed.raw[base + 1u]) << 8u);
        float d = unpackHalf2x16(d_bits).x;
        for (uint i = 0u; i < 32u; ++i) {
            int q = int(packed.raw[base + 2u + i]);
            if (q >= 128) q -= 256;
            sum += d * float(q) * input_data.values[block * 32u + i];
        }
    }
    output_data.values[row] = sum;
}

